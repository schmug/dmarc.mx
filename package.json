{
  "name": "dmarcheck",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run && vitest run --project=node --coverage",
    "test:watch": "vitest",
    "record": "tsx scripts/record-fixture.ts",
    "lint": "biome check src/ test/",
    "lint:fix": "biome check --write src/ test/",
    "types": "wrangler types --include-runtime=false --env-interface=GeneratedBindings",
    "typecheck": "wrangler types --check --include-runtime=false --env-interface=GeneratedBindings && tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261002.1",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.1",
    "@types/dns-packet": "^5.6.1",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^4.1.11",
    "minimatch": "^10.2.6",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.146.0"
  },
  "dependencies": {
    "@sentry/cloudflare": "^11.2.0",
    "dns-packet": "^5.6.1",
    "hono": "^4.13.12",
    "jose": "^6.2.12"
  },
  "overrides": {
    "sharp": "$sharp",
    "undici": "^7.29.0"
  }
}
